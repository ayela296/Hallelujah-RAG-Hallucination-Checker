# Gemini embedding API key (Obtain from Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Retained for existing application features that read GOOGLE_API_KEY.
GOOGLE_API_KEY=your_google_api_key_here

# Optional Application Configuration Overrides
# MODEL_NAME=gemini-2.5-flash
# MAX_ANSWER_CHARS=5000